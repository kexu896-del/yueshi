{
  "说明": "常备调味基础包与味型公式。同一份食材篮子通过换味型避免口味重复（菜谱指纹的 flavor 维度从这里取值）。",
  "常备基础包": {
    "中式基础": ["生抽", "老抽", "料酒", "香醋", "盐", "姜", "蒜", "小葱"],
    "增味可选": ["蚝油", "豆瓣酱", "花椒", "干辣椒", "白胡椒", "十三香"],
    "酮生物加配": ["黄油或椰子油", "橄榄油", "代糖（可选）"],
    "平衡激素加配": ["糙米/燕麦米", "红薯/玉米", "少量蜂蜜（调味用）"]
  },
  "味型公式": {
    "咸鲜": "生抽+盐+葱姜蒜",
    "酱香": "生抽+老抽+蚝油（+豆瓣酱）",
    "红烧": "生抽+老抽+冰糖少量+八角",
    "酸甜": "香醋+糖（酮生物用代糖）+番茄酱",
    "麻辣": "花椒+干辣椒+豆瓣酱",
    "酸辣": "香醋+小米椒+蒜",
    "蒜香": "大量蒜蓉+生抽+蚝油",
    "黑椒": "黑胡椒碎+生抽+黄油",
    "咖喱": "咖喱粉+椰浆或牛奶（酮生物用椰浆）",
    "孜然": "孜然粒+辣椒粉+盐",
    "清淡": "盐+姜片+白胡椒",
    "葱香": "小葱/大葱+生抽+香油",
    "酒香": "啤酒或料酒+生抽+姜"
  },
  "使用规则": [
    "一周内同一味型出现不超过 3 次",
    "连续两顿不使用同一味型",
    "高油重口味型（麻辣/红烧/咖喱）每周合计 ≤2 次",
    "清淡味型每天至少保留 1 次（晚餐优先）"
  ]
}
