{
  "taxonomy_version": "1.0.0",
  "note": "菜品一级类型（dish_category）唯一权威定义。分类器 recipe_classifier.py 只按本文件的 enum 与规则产出；正餐候选池与多样性门禁的适用范围以此为准。",
  "dish_category_enum": [
    "main_dish",
    "staple",
    "soup",
    "side",
    "breakfast",
    "dessert",
    "beverage",
    "sauce_or_condiment",
    "snack",
    "composite_meal"
  ],
  "definitions": {
    "main_dish": "以主要蛋白或主要蔬菜为核心的正餐菜",
    "staple": "米、面、饼、粥、粉、薯类等主食",
    "soup": "独立作为汤品或汤羹使用",
    "side": "配菜、凉菜、小菜",
    "breakfast": "明确为早餐结构或早餐模板",
    "dessert": "蛋糕、布丁、甜品、冰品等",
    "beverage": "茶饮、奶饮、果饮及其他饮品",
    "sauce_or_condiment": "糖浆、蘸料、酱汁、调味底料",
    "snack": "不作为正餐主体的小食",
    "composite_meal": "整盘饭、套餐、完整一锅餐等复合结构"
  },
  "allowed_for_main_meal": [
    "main_dish",
    "staple",
    "soup",
    "side",
    "composite_meal"
  ],
