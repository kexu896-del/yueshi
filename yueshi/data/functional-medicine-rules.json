{
  "schema_version": "1.0.0",
  "registry_id": "functional-medicine-rules",
  "version": "1.0.0",
  "说明": "round70 五书精读 A 级规则结构化落地（round70.1，2026-09-21）。规则来源：book-extraction/ 下五份精读报告的「月食最终采纳清单」A 级（共 84 条）。本库只承载行为与食物层面规则：auto_tip=true 的规则可作为执行提示候选（每份计划 0 至 2 条，tip_key 去重）；协议类（消除-回添）、安全转介、监测建议与认知纠偏一律 auto_tip=false，须用户主动发起并经安全路由。数值型主张仅作参考（numeric_policy=reference_only），一律不写入 data/effective-parameters.json；模式配额与蛋白目标仍以批准参数为唯一生产来源。",
  "numeric_policy": "reference_only",
  "books": {
    "deep-nutrition": {"title_zh": "《Deep Nutrition》", "author": "Catherine Shanahan"},
    "good-energy": {"title_zh": "《Good Energy》", "author": "Casey Means"},
    "the-disease-delusion": {"title_zh": "《The Disease Delusion》", "author": "Jeffrey Bland"},
    "why-we-get-sick": {"title_zh": "《Why We Get Sick》", "author": "Benjamin Bikman"},
    "beat-autoimmune": {"title_zh": "《Beat Autoimmune》", "author": "Palmer Kippola"}
  },
  "categories": ["food_selection", "meal_structure", "eating_behavior", "cooking", "daily_rhythm", "gut_repair", "self_immunity", "preconception", "lactation", "monitoring", "education", "redline"],
  "rules": [
    {"rule_id": "FM-DN-01", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "cooking_oil", "tip_text": "炒菜用油优先橄榄油，少用精炼种子油", "note": "第7章；精炼种子油争议已在共识矩阵标注采纳口径"},
    {"rule_id": "FM-DN-02", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "sugar_aliases", "tip_text": "买包装食品先看配料表，认准糖的别名", "note": "第9章；添加糖黑名单 + 24 种糖别名"},
    {"rule_id": "FM-DN-03", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "vegetable_oil_check", "tip_text": "配料表前六位有植物油的，换一款", "note": "第13章；厨房排毒规则"},
    {"rule_id": "FM-DN-04", "book": "deep-nutrition", "category": "meal_structure", "applies_to": ["keto_biologic", "weight_loss"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第9、13章；碳水配额 ≤100g/日、早餐 ≤10g 属数值型主张，仅参考；模式配额以 effective-parameters 批准参数为准"},
    {"rule_id": "FM-DN-05", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "fruit_juice", "tip_text": "果汁当含糖饮料看，水果每天一份就好", "note": "第9章；果汁视同含糖饮料"},
    {"rule_id": "FM-DN-06", "book": "deep-nutrition", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "bone_broth_week", "tip_text": "每周安排两次骨汤或带骨肉，内脏少量", "note": "第10章；传统饮食四支柱周结构"},
    {"rule_id": "FM-DN-07", "book": "deep-nutrition", "category": "cooking", "applies_to": ["*"], "auto_tip": true, "tip_key": "bone_broth_use", "tip_text": "炖菜炖饭用骨汤做底，味道好也养人", "note": "第10、13、14章；骨汤入菜技巧"},
    {"rule_id": "FM-DN-08", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "fermented_soy", "tip_text": "豆制品优先发酵型，如豆豉、腐乳", "note": "第10章；豆制品分级"},
    {"rule_id": "FM-DN-09", "book": "deep-nutrition", "category": "cooking", "applies_to": ["*"], "auto_tip": true, "tip_key": "gentle_meat", "tip_text": "肉多用炖、蒸、快炒，别久煮过熟", "note": "第10章；肉类温和烹饪"},
    {"rule_id": "FM-DN-10", "book": "deep-nutrition", "category": "preconception", "applies_to": ["preconception"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第5章；备孕提前 ≥3 个月、两胎间隔 ≥3 年、男方同步优化；仅原书观点，孕产人群走安全路由，用户主动发起"},
    {"rule_id": "FM-DN-11", "book": "deep-nutrition", "category": "lactation", "applies_to": ["lactation"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第14章；哺乳期不过度控碳（约 70g/日泌乳需求）为原书观点，须专业人员确认，不自动执行"},
    {"rule_id": "FM-DN-12", "book": "deep-nutrition", "category": "education", "applies_to": ["*"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第9章；「淀粉=糖」认知纠偏与辟谣，用户问到时如实介绍"},
    {"rule_id": "FM-DN-13", "book": "deep-nutrition", "category": "education", "applies_to": ["*"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第14章；酸碱性饮食理论辟谣条目，仅背景知识"},
    {"rule_id": "FM-DN-14", "book": "deep-nutrition", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "fatty_fish", "tip_text": "omega-3 优先吃鱼，每周两次富脂鱼", "note": "第8、13章；食物化原则，不主动推鱼油胶囊"},

    {"rule_id": "FM-GE-01", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "triple_threat", "tip_text": "包装食品避开糖、种子油、精制面粉", "note": "第6章；配料表三合一审查"},
    {"rule_id": "FM-GE-02", "book": "good-energy", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "meal_structure", "tip_text": "每餐凑齐蔬菜、蛋白、纤维、发酵食品", "note": "第6章；每餐五组件完整性校验"},
    {"rule_id": "FM-GE-03", "book": "good-energy", "category": "eating_behavior", "applies_to": ["*"], "auto_tip": true, "tip_key": "eating_order", "tip_text": "先吃菜和蛋白，最后再吃主食", "note": "第6章；不裸碳水 + 先菜后饭"},
    {"rule_id": "FM-GE-04", "book": "good-energy", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "last_meal", "tip_text": "晚餐尽量早，和睡觉隔三小时以上", "note": "第6、7章；限时进食窗口默认 12h，最后一餐距睡眠 ≥3 小时"},
    {"rule_id": "FM-GE-05", "book": "good-energy", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "carb_daylight", "tip_text": "主食多放在午餐，晚餐清淡少碳水", "note": "第6、7章；高碳水餐放白天"},
    {"rule_id": "FM-GE-06", "book": "good-energy", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "post_meal_walk", "tip_text": "饭后散步十五分钟，帮助平稳血糖", "note": "第6章；餐后散步 ≥15 分钟"},
    {"rule_id": "FM-GE-07", "book": "good-energy", "category": "eating_behavior", "applies_to": ["*"], "auto_tip": true, "tip_key": "no_liquid_sugar", "tip_text": "含糖饮料、果汁、奶茶尽量不喝", "note": "第6章；不喝液体热量"},
    {"rule_id": "FM-GE-08", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "omega3_food", "tip_text": "每周两次富脂鱼，拌菜可加亚麻籽", "note": "Part 3；omega-3 每日 ≥2g 食物来源，数值仅参考"},
    {"rule_id": "FM-GE-09", "book": "good-energy", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "fiber", "tip_text": "主食换全谷杂粮，蔬菜每天多两把", "note": "第6章；纤维目标 30g 起、进阶 50g，渐进适应"},
    {"rule_id": "FM-GE-10", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "fermented", "tip_text": "每天来一份无糖酸奶或泡菜等发酵食品", "note": "第6章；发酵食品每日 ≥1 份，无糖、活性菌标注校验"},
    {"rule_id": "FM-GE-11", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "plant_variety", "tip_text": "一周蔬菜换着买，种类越多越好", "note": "第6章；每周 30 种植物多样性"},
    {"rule_id": "FM-GE-12", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "cruciferous", "tip_text": "每天安排西兰花、甘蓝等十字花科", "note": "第6章；十字花科每日 ≥2 份，静置激活技巧作提示"},
    {"rule_id": "FM-GE-13", "book": "good-energy", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "sleep", "tip_text": "作息固定，起床后晒几分钟太阳", "note": "第7章；睡眠 7-8h + 作息一致 + 晨光"},
    {"rule_id": "FM-GE-14", "book": "good-energy", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "daily_activity", "tip_text": "每坐一小时，起身活动两分钟", "note": "第8章；运动三底线 + 每小时起身"},
    {"rule_id": "FM-GE-15", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "alcohol", "tip_text": "酒尽量少喝，尤其别在睡前喝", "note": "第6章；酒精最小化"},
    {"rule_id": "FM-GE-16", "book": "good-energy", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "small_fish", "tip_text": "鱼优先小型鱼，大型鱼每周最多一次", "note": "Part 3；大汞鱼每周 ≤1 次"},
    {"rule_id": "FM-GE-17", "book": "good-energy", "category": "eating_behavior", "applies_to": ["*"], "auto_tip": true, "tip_key": "mindful_eating", "tip_text": "吃饭放慢，专心吃，每口多嚼几下", "note": "第6章；正念慢食提示"},

    {"rule_id": "FM-DD-01", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "low_gl", "tip_text": "主食选低升糖的：全谷、豆类、薯类", "note": "第11章；低升糖负荷第一原则"},
    {"rule_id": "FM-DD-02", "book": "the-disease-delusion", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "mediterranean_plate", "tip_text": "餐盘多放蔬菜，动物性食物适量", "note": "第12章；地中海式结构 60-70% 植物"},
    {"rule_id": "FM-DD-03", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "color_variety", "tip_text": "每天换着花样吃不同颜色的蔬果", "note": "第12章；植物营养素多样性"},
    {"rule_id": "FM-DD-04", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "trans_fat", "tip_text": "配料表有氢化油的加工食品不要买", "note": "第11章；杜绝反式脂肪"},
    {"rule_id": "FM-DD-05", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "hfcs", "tip_text": "有果葡糖浆的饮料零食不买", "note": "第10、13章；高果糖玉米糖浆零容忍"},
    {"rule_id": "FM-DD-06", "book": "the-disease-delusion", "category": "cooking", "applies_to": ["*"], "auto_tip": true, "tip_key": "low_temp_cooking", "tip_text": "多用蒸煮炖，少炭烤、少高温煎炸", "note": "第10、12章；低温烹饪、避免炭烤焦化"},
    {"rule_id": "FM-DD-07", "book": "the-disease-delusion", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "post_meal_walk", "tip_text": "饭后走一走，十五分钟就够", "note": "第13章；餐后 15-20 分钟步行"},
    {"rule_id": "FM-DD-08", "book": "the-disease-delusion", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "cardio", "tip_text": "每天走到一万步，每周三次有氧", "note": "第11-13章；步数与有氧目标，数值仅参考"},
    {"rule_id": "FM-DD-09", "book": "the-disease-delusion", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": true, "tip_key": "strength", "tip_text": "有氧之外，每周两次力量训练", "note": "第9章；有氧 + 抗阻交叉训练"},
    {"rule_id": "FM-DD-10", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "long_grain_rice", "tip_text": "米饭优先长粒米，糯米少吃", "note": "第13章；长粒米优于短粒糯米"},
    {"rule_id": "FM-DD-11", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "soluble_fiber", "tip_text": "燕麦、大麦、豆类每天安排一点", "note": "第13章；可溶性纤维延缓葡萄糖吸收"},
    {"rule_id": "FM-DD-12", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["vegetarian"], "auto_tip": true, "tip_key": "grain_legume", "tip_text": "素食时谷类和豆类搭配着吃", "note": "第13章；谷物 + 豆类补全氨基酸（素食用户）"},
    {"rule_id": "FM-DD-13", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "cruciferous", "tip_text": "十字花科蔬菜每天都安排一份", "note": "第5章；每日十字花科"},
    {"rule_id": "FM-DD-14", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "sulfur_veg", "tip_text": "炒菜多放蒜、葱、韭菜提味", "note": "第5章；每日含硫调味蔬菜"},
    {"rule_id": "FM-DD-15", "book": "the-disease-delusion", "category": "gut_repair", "applies_to": ["self_immunity", "gut_repair"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第12、13章；常见致敏食物 2 周排除-复引法，属协议类，须用户主动发起并经安全路由"},
    {"rule_id": "FM-DD-16", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "plastic_heat", "tip_text": "热食热饮尽量用玻璃或不锈钢容器", "note": "第10、11章；避免塑料容器盛热食热饮"},
    {"rule_id": "FM-DD-17", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "dark_greens", "tip_text": "每天一份深绿色叶菜，如菠菜油菜", "note": "第13章；深绿色叶菜常规摄入"},
    {"rule_id": "FM-DD-18", "book": "the-disease-delusion", "category": "daily_rhythm", "applies_to": ["menopause"], "auto_tip": true, "tip_key": "bone_health", "tip_text": "补钙的同时搭配负重运动，效果更好", "note": "第13章；钙/维 D 绑定负重运动（更年期/骨健康）"},
    {"rule_id": "FM-DD-19", "book": "the-disease-delusion", "category": "education", "applies_to": ["*"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第11章；12 周为方案评估周期，属过程建议，用户主动了解时介绍"},
    {"rule_id": "FM-DD-20", "book": "the-disease-delusion", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "protein_each_meal", "tip_text": "每餐都安排一份蛋白质，简单蒸煮就好", "note": "第9、13章；优质蛋白每餐保障"},
    {"rule_id": "FM-DD-21", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "spices", "tip_text": "做菜常放姜、蒜、姜黄、肉桂", "note": "第7、13章；每日香料入菜"},
    {"rule_id": "FM-DD-22", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "cooking_oil", "tip_text": "初榨橄榄油做主要烹调用油", "note": "第8、11章；初榨橄榄油为主"},
    {"rule_id": "FM-DD-23", "book": "the-disease-delusion", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "fatty_fish", "tip_text": "每周安排一次三文鱼、鲭鱼等富脂鱼", "note": "第8章；每周富脂鱼"},

    {"rule_id": "FM-WW-01", "book": "why-we-get-sick", "category": "meal_structure", "applies_to": ["*"], "auto_tip": true, "tip_key": "meal_structure", "tip_text": "每餐先定蛋白和蔬菜，再配少量主食", "note": "第15/17章；每餐结构：蛋白+脂肪+非淀粉蔬菜打底"},
    {"rule_id": "FM-WW-02", "book": "why-we-get-sick", "category": "meal_structure", "applies_to": ["keto_biologic", "weight_loss"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第17章；碳水三档 <50/<75/<100g 按风险分层，属数值型主张，仅参考；模式配额以批准参数为准"},
    {"rule_id": "FM-WW-03", "book": "why-we-get-sick", "category": "meal_structure", "applies_to": ["*"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第17章；蛋白质 1-1.5 g/kg/天（老年取上限），数值仅参考；蛋白目标以 effective-parameters 批准参数为准"},
    {"rule_id": "FM-WW-04", "book": "why-we-get-sick", "category": "eating_behavior", "applies_to": ["*"], "auto_tip": true, "tip_key": "eating_order", "tip_text": "先吃菜和肉，后吃主食", "note": "第15章；进餐顺序"},
    {"rule_id": "FM-WW-05", "book": "why-we-get-sick", "category": "daily_rhythm", "applies_to": ["*"], "auto_tip": false, "tip_key": null, "tip_text": null, "note": "第17章；12 小时夜间禁食为默认、稳糖/体重模式加每周 2-3 天 16-18h 窗口——由断食窗口安排（runtime-rules.md）承载，不重复提示"},
    {"rule_id": "FM-WW-06", "book": "why-we-get-sick", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "no_liquid_sugar", "tip_text": "果汁、含糖饮料、运动饮料都少碰", "note": "第7/15章；液体糖黑名单，完整水果按 GL 放行"},
    {"rule_id": "FM-WW-07", "book": "why-we-get-sick", "category": "cooking", "applies_to": ["*"], "auto_tip": true, "tip_key": "cooking_oil_heat", "tip_text": "高温炒菜用烟点高的油，凉拌用橄榄油", "note": "第17章；食用油按烟点分层，避免工业种子油（争议已标注）"},
    {"rule_id": "FM-WW-08", "book": "why-we-get-sick", "category": "food_selection", "applies_to": ["*"], "auto_tip": true, "tip_key": "sweeteners", "tip_text": "代糖优先选甜菊、赤藓糖醇", "note": "第17章；代糖分级，三氯蔗糖/阿斯巴甜不随餐"},
