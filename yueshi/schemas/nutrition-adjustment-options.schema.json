{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "月食 · 统一营养调整候选表",
  "type": "object",
  "required": ["schema_version", "data_version", "generated_from_foods_table_version", "updated_at", "options"],
  "properties": {
    "schema_version": {"type": "string"},
    "data_version": {"type": "string"},
    "generated_from_foods_table_version": {"type": "string"},
    "updated_at": {"type": "string"},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "adjustment_id", "ingredient_id", "display_name", "adjustment_action",
          "increment_value", "increment_unit", "nutrition_delta", "suitable_meals",
          "source_scope", "mode_tags", "max_steps_per_day", "max_total_change",
          "package_impact", "meal_structure_impact", "requires_recipe_change",
          "requires_user_confirmation", "priority", "enabled", "version"
        ],
        "properties": {
          "adjustment_id": {"type": "string", "minLength": 1},
          "ingredient_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "adjustment_action": {"enum": ["increase", "decrease", "replace", "remove"]},
          "increment_value": {"type": "number", "exclusiveMinimum": 0},
          "increment_unit": {"enum": ["g", "ml", "item", "portion"]},
          "nutrition_delta": {
            "type": "object",
            "required": ["energy_kcal", "protein_g", "net_carbs_g", "fat_g"],
            "properties": {
              "energy_kcal": {"type": "number"},
              "protein_g": {"type": "number"},
              "net_carbs_g": {"type": "number"},
              "fat_g": {"type": "number"}
            },
            "additionalProperties": false
          },
          "suitable_meals": {
            "type": "array", "minItems": 1,
            "items": {"enum": ["breakfast", "lunch", "dinner", "snack"]}
          },
          "source_scope": {
            "type": "array", "minItems": 1,
            "items": {"enum": ["locked_basket", "inventory", "approved_substitution"]}
          },
          "mode_tags": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "goal_tags": {"type": "array", "items": {"type": "string"}},
          "restriction_tags": {"type": "array", "items": {"type": "string"}},
          "max_steps_per_day": {"type": "integer", "minimum": 1},
          "max_total_change": {"type": "number", "exclusiveMinimum": 0},
          "package_impact": {"enum": ["none", "improves", "worsens"]},
          "meal_structure_impact": {"enum": ["none", "compatible", "breaks_structure"]},
          "requires_recipe_change": {"type": "boolean"},
          "requires_user_confirmation": {"type": "boolean"},
          "priority": {"type": "number"},
          "enabled": {"type": "boolean"},
          "version": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
